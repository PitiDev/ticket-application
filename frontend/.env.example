# ====================================
# FRONTEND CONFIGURATION (Nuxt 3)
# ====================================

# API Base URL - Backend API endpoint
# For development (local): http://localhost:9000/api
# For production: http://your-server-ip:9000/api or your domain/api
NUXT_PUBLIC_API_BASE=http://localhost:9000/api

# Application URL
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Environment
NODE_ENV=development
