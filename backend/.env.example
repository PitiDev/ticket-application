# ====================================
# BACKEND CONFIGURATION
# ====================================

# Server Configuration
NODE_ENV=development
PORT=9000
BASE_URL=http://localhost:9000

# Database Configuration
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=ticket_system
DB_PORT=3306

# Security
JWT_SECRET=your_jwt_secret_generate_a_random_string

# Frontend URL (for links in emails and CORS)
FRONTEND_URL=http://localhost:3000

# Email Configuration
# Option 1: Gmail SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM_NAME=Your App Name
MAIL_FROM_ADDRESS=noreply@yourapp.com

# Option 2: Office365 SMTP (uncomment to use)
# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=your_email@office365.com
# MAIL_PASS=your_password
# MAIL_FROM_NAME=Your App Name
# MAIL_FROM_ADDRESS=noreply@yourapp.com

# Google Generative AI (Gemini) - Optional
GEMINI_API_KEY=your_gemini_api_key

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Session Configuration
SESSION_SECRET=your_session_secret_generate_a_random_string
